# Copy this file to .env for local development.
# On Render, add the same keys under Environment instead.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/blogify?retryWrites=true&w=majority

# Two long random strings (different from each other)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Your frontend's address(es), comma separated. Leave empty to allow any origin.
CLIENT_URL=http://localhost:5173

PORT=3000
